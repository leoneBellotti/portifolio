---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCaseStudy from '../../components/ProjectCaseStudy.astro';
import { getDictionary } from '../../i18n';
import { route } from '../../i18n/routes';
import { SITE_URL } from '../../site.config';
import { creativeWorkJsonLd } from '../../seo';

const lang = 'pt' as const;
const dict = getDictionary(lang);
const project = dict.projects.items.find((p) => p.slug === '3dt-online')!;
const canonicalUrl = new URL(route('project3dt', lang), SITE_URL).toString();
---

<BaseLayout
  lang={lang}
  routeKey="project3dt"
  title={`${project.name} — ${dict.meta.projects.title}`}
  description={project.tagline}
  jsonLd={[creativeWorkJsonLd(project, canonicalUrl)]}
>
  <ProjectCaseStudy project={project} lang={lang} />
</BaseLayout>
