---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lang = 'pt' as const;
---

<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Página não encontrada / Page not found</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header lang={lang} routeKey="home" />
    <main class="flex-1">
      <section class="mx-auto max-w-2xl px-4 sm:px-6 py-24 text-center">
        <p class="font-tech text-accent text-sm">404</p>
        <h1 class="mt-3 text-3xl font-bold">Página não encontrada</h1>
        <p class="mt-2 text-muted">O endereço acessado não existe ou foi movido.</p>
        <a href="/" class="btn btn-primary mt-8">Voltar para o início</a>

        <hr class="my-10 border-subtle" />

        <h1 class="text-3xl font-bold">Page not found</h1>
        <p class="mt-2 text-muted">The page you're looking for doesn't exist or has moved.</p>
        <a href="/en/" class="btn btn-secondary mt-8">Back to home</a>
      </section>
    </main>
    <Footer lang={lang} />
  </body>
</html>
