---
import type { Locale } from '../../site.config';
import { getDictionary } from '../../i18n';
import Section from '../Section.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const b = dict.blog;
---

<Section title={b.title} intro={b.intro} titleAs="h1">
  <div class="surface rounded-xl p-8 max-w-xl text-center text-muted">
    <p class="font-tech text-sm">{b.emptyState}</p>
  </div>
</Section>
