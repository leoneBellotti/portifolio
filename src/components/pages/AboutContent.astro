---
import type { Locale } from '../../site.config';
import { getDictionary } from '../../i18n';
import Section from '../Section.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const a = dict.about;
---

<Section title={a.title} titleAs="h1">
  <div class="max-w-3xl space-y-6">
    <p class="prose-body text-lg text-muted">{a.intro}</p>
    <p class="prose-body text-muted">{a.fullSummary}</p>
  </div>
</Section>

<Section title={a.diffsTitle} class="border-t border-subtle">
  <ul class="grid gap-4 sm:grid-cols-2 max-w-4xl">
    {a.diffs.map((diff) => (
      <li class="surface rounded-lg p-4 text-sm text-muted flex gap-3">
        <span class="text-accent shrink-0" aria-hidden="true">▹</span>
        {diff}
      </li>
    ))}
  </ul>
</Section>

<Section class="border-t border-subtle">
  <div class="surface rounded-xl p-6 sm:p-8 max-w-3xl">
    <h2 class="font-tech text-xs uppercase tracking-wide text-accent">{a.valuePropositionTitle}</h2>
    <p class="mt-3 prose-body text-lg">{a.valueProposition}</p>
  </div>
</Section>

<Section class="border-t border-subtle">
  <div class="max-w-3xl">
    <h2 class="text-sm font-medium text-muted">{a.educationTitle}</h2>
    <p class="mt-1 text-sm text-muted">{a.educationText}</p>
  </div>
</Section>
