---
import type { Locale } from '../../site.config';
import { getDictionary } from '../../i18n';
import { route } from '../../i18n/routes';
import { RESUME_PATH } from '../../site.config';
import Avatar from '../Avatar.astro';
import Section from '../Section.astro';
import ServiceCard from '../ServiceCard.astro';
import ProjectCard from '../ProjectCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const s = dict.services;
const p = dict.projects;
const e = dict.experience.entry;

const projectRouteKeys = ['projectAtendepix', 'project3dt', 'projectSakkamusuko'] as const;
---

<section class="bg-hero-grid border-b border-subtle">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-20 sm:py-28 grid gap-12 lg:grid-cols-[1.2fr_auto] items-center">
    <div>
      <p class="font-tech text-sm text-accent">{dict.hero.title}</p>
      <h1 class="mt-3 text-3xl sm:text-5xl font-bold tracking-tight max-w-2xl leading-tight">
        {dict.hero.subtitle}
      </h1>
      <p class="mt-6 text-muted max-w-xl">{dict.home.summaryShort}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={route('projects', lang)} class="btn btn-primary">{dict.common.ctaViewProjects}</a>
        <a href={route('contact', lang)} class="btn btn-secondary">{dict.common.ctaContactMe}</a>
        <a href={RESUME_PATH[lang]} download class="btn btn-secondary">{dict.common.ctaDownloadResume}</a>
      </div>
    </div>
    <Avatar size={180} class="mx-auto lg:mx-0" />
  </div>
</section>

<Section title={dict.home.servicesTitle} intro={dict.home.servicesIntro}>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {s.items.slice(0, 3).map((entry) => (
      <ServiceCard
        entry={entry}
        problemLabel={s.problemLabel}
        clientLabel={s.clientLabel}
        deliverablesLabel={s.deliverablesLabel}
        modelLabel={s.modelLabel}
      />
    ))}
  </div>
  <a href={route('services', lang)} class="inline-block mt-8 text-sm font-medium hover:text-accent">
    {dict.home.seeAllServices} &rarr;
  </a>
</Section>

<Section title={dict.home.projectsTitle} intro={dict.home.projectsIntro} class="border-t border-subtle">
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {p.items.map((project, i) => (
      <ProjectCard project={project} href={route(projectRouteKeys[i], lang)} viewCaseLabel={dict.common.viewCase} />
    ))}
  </div>
  <a href={route('projects', lang)} class="inline-block mt-8 text-sm font-medium hover:text-accent">
    {dict.home.seeAllProjects} &rarr;
  </a>
</Section>

<Section title={dict.home.experienceTitle} intro={dict.home.experienceIntro} class="border-t border-subtle">
  <div class="surface rounded-xl p-6 sm:p-8 max-w-3xl">
    <p class="font-tech text-lg font-bold">{e.company}</p>
    <p class="text-sm text-muted mt-1">{e.period}</p>
    <ol class="mt-4 flex flex-wrap gap-2 text-sm">
      {e.roles.map((role, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span class="text-muted" aria-hidden="true">&rarr;</span>}
          <span class:list={[i === e.roles.length - 1 ? 'text-accent font-medium' : 'text-muted']}>{role}</span>
        </li>
      ))}
    </ol>
  </div>
  <a href={route('experience', lang)} class="inline-block mt-6 text-sm font-medium hover:text-accent">
    {dict.nav.experience} &rarr;
  </a>
</Section>

<Section title={dict.home.contactTitle} intro={dict.home.contactIntro} class="border-t border-subtle">
  <a href={route('contact', lang)} class="btn btn-primary">{dict.common.ctaContactMe}</a>
</Section>
