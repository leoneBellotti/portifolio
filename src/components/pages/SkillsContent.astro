---
import type { Locale } from '../../site.config';
import { getDictionary } from '../../i18n';
import Section from '../Section.astro';
import TechBadgeList from '../TechBadgeList.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const sk = dict.skills;
---

<Section title={sk.title} intro={sk.intro} titleAs="h1">
  <div class="grid gap-6 sm:grid-cols-2">
    {sk.groups.map((group) => (
      <div class="surface rounded-xl p-6">
        <h3 class="font-bold">{group.title}</h3>
        <TechBadgeList items={group.items} class="mt-4" />
      </div>
    ))}
  </div>
</Section>
