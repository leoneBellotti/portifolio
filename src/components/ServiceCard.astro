---
import type { ServiceEntry } from '../i18n/types';

interface Props {
  entry: ServiceEntry;
  problemLabel: string;
  clientLabel: string;
  deliverablesLabel: string;
  modelLabel: string;
}

const { entry, problemLabel, clientLabel, deliverablesLabel, modelLabel } = Astro.props;
---

<article class="surface rounded-xl p-6 flex flex-col h-full">
  <h3 class="text-lg font-bold">{entry.title}</h3>
  <p class="mt-2 text-sm text-muted">{entry.description}</p>

  <dl class="mt-4 space-y-3 text-sm flex-1">
    <div>
      <dt class="font-tech text-xs uppercase tracking-wide text-accent">{problemLabel}</dt>
      <dd class="text-muted mt-1">{entry.problem}</dd>
    </div>
    <div>
      <dt class="font-tech text-xs uppercase tracking-wide text-accent">{clientLabel}</dt>
      <dd class="text-muted mt-1">{entry.idealClient}</dd>
    </div>
    <div>
      <dt class="font-tech text-xs uppercase tracking-wide text-accent">{deliverablesLabel}</dt>
      <dd class="text-muted mt-1">{entry.deliverables}</dd>
    </div>
  </dl>

  <p class="mt-4 pt-4 border-t border-subtle text-xs font-tech text-muted">{modelLabel}: {entry.model}</p>
</article>
