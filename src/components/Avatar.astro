---
interface Props {
  size?: number;
  class?: string;
}

const { size = 160, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 160 160"
  role="img"
  aria-label="Leone Bellotti"
  class={className}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="avatar-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="var(--accent)" />
      <stop offset="100%" stop-color="var(--accent-2)" />
    </linearGradient>
  </defs>
  <rect width="160" height="160" rx="24" fill="var(--bg-elevated)" stroke="var(--border)" />
  <rect x="1" y="1" width="158" height="158" rx="23" fill="none" stroke="url(#avatar-gradient)" stroke-width="2" opacity="0.6" />
  <text
    x="50%"
    y="54%"
    dominant-baseline="middle"
    text-anchor="middle"
    font-family="'JetBrains Mono', ui-monospace, monospace"
    font-weight="700"
    font-size="58"
    fill="url(#avatar-gradient)"
  >LB</text>
  <text
    x="50%"
    y="82%"
    dominant-baseline="middle"
    text-anchor="middle"
    font-family="'JetBrains Mono', ui-monospace, monospace"
    font-size="12"
    letter-spacing="2"
    fill="var(--fg-muted)"
  >&lt;/&gt;</text>
</svg>
